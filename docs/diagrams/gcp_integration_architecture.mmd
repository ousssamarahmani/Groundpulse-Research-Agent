    ADK[Google ADK — primary framework<br/>tools • evaluation • deployment]:::compute
    TEAM[ADK multi-agent team<br/>future coordinator + specialists]:::optional
  end

  subgraph A[GroundPulse research path]
    W[Cloud Run / Cloud Run Job<br/>GroundPulse agent worker<br/>ADK target implementation]:::compute
    V[Evidence validator<br/>claim ledger gate]:::compute
    FS[(Firestore<br/>run state • agent memory<br/>evidence references)]:::data
  end

  subgraph D[Evidence and analytics]
    RAW[(Cloud Storage<br/>immutable raw snapshots)]:::data
    FLOW[Dataflow<br/>only for windowing / dedupe / enrichment]:::optional
    BQ[(BigQuery<br/>normalized events / aggregates)]:::data
    ART[(Cloud Storage<br/>PDF • JSON manifest • package)]:::data
  end

  UI[GroundPulse UI<br/>Landing page + Mission Control]:::control

